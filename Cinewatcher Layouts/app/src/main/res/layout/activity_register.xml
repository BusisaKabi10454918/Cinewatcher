<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".register"
    android:background="@drawable/background">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="fill_parent"

        android:layout_marginTop="90dp">

        <ImageView
            android:id="@+id/btn_addImage"
            android:layout_width="195dp"
            android:layout_height="195dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@color/white"
            android:layout_marginTop="10dp"
            />
        <!--  This will be where we handle people
        setting their profile pictures-->


        <EditText
            android:id="@+id/et_usernameField"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_bg"
            android:layout_margin="20dp"
            android:textColor="@color/grey"
            android:textAlignment="textStart"
            android:paddingLeft="20dp"
            android:hint="Enter Username"
            android:textColorHint="@color/light_grey"

            app:layout_constraintTop_toBottomOf="@id/btn_addImage"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <EditText
            android:id="@+id/et_passwordField"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_bg"
            android:layout_margin="20dp"
            android:textColor="@color/grey"
            android:textAlignment="textStart"
            android:paddingLeft="20dp"
            android:hint="Enter Password"
            android:textColorHint="@color/light_grey"
            android:inputType="textPassword"

            app:layout_constraintTop_toBottomOf="@id/et_usernameField"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <EditText
            android:id="@+id/et_confirmPasswordField"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_bg"
            android:layout_margin="20dp"
            android:textColor="@color/grey"
            android:textAlignment="textStart"
            android:paddingLeft="20dp"
            android:hint="Confirm Password"
            android:textColorHint="@color/light_grey"
            android:inputType="textPassword"

            app:layout_constraintTop_toBottomOf="@id/et_passwordField"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <Button
            android:id="@+id/btn_register"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/navy"
            android:layout_margin="20dp"

            android:text="Register"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/et_confirmPasswordField"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            />
        <!--  Here we need to handle password confirmation
        and check if the username isn't already taken-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>