<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".list"
    android:background="@drawable/background">

    <ImageButton
        android:id="@+id/returnButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="10dp"
        android:contentDescription="returnButton"
        android:src="@drawable/back_button"
        android:background="@android:color/transparent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/pageHeading"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="20dp"

        android:text="My List"
        android:textColor="@color/white"
        android:textSize="30sp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentWindow"
        android:layout_width="match_parent"
        android:layout_height="550dp"
        android:layout_margin="20dp"
        android:layout_marginTop="100dp"

        app:layout_constraintTop_toBottomOf="@id/pageHeading"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentBoxA"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/light_grey"
            android:layout_margin="20dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentBoxB"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/light_grey"
            android:layout_margin="20dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentBoxC"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/light_grey"
            android:layout_margin="20dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentBoxA"
            app:layout_constraintBottom_toTopOf="@id/contentBoxE">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentBoxD"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/light_grey"
            android:layout_margin="20dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentBoxB"
            app:layout_constraintBottom_toTopOf="@id/contentBoxF">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentBoxE"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/light_grey"
            android:layout_margin="20dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentBoxF"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/light_grey"
            android:layout_margin="20dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>