<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".movie"
    android:background="@drawable/background">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_bg"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <ImageButton
            android:id="@+id/search_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="10dp"
            android:contentDescription="Search"
            android:src="@drawable/search_icon"
            android:background="@android:color/transparent"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <EditText
            android:id="@+id/search_field"
            android:layout_width="230dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_bg"

            android:layout_margin="10dp"

            android:hint="Search Cinewatcher"
            android:textAlignment="textStart"
            android:textColorHint="@color/light_grey"
            android:inputType="text"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/search_button"
            />

        <ImageButton
            android:id="@+id/options_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="10dp"
            android:contentDescription="Options"
            android:src="@drawable/options_button"
            android:background="@android:color/transparent"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="390dp"
        android:background="@color/black"
        android:alpha="0.5"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:foreground="@drawable/fade_bottom"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/moviePoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"


            android:contentDescription="moviePoster" />


    </FrameLayout>

    <TextView
        android:id="@+id/movieName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Movie Name"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:layout_marginTop="160dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="100dp"

        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageButton
        android:id="@+id/saveButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/unsaved_icon"
        android:background="@android:color/transparent"

        android:layout_marginTop="160dp"
        android:contentDescription="Save"

        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintStart_toEndOf="@id/movieName"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/currentRatingStar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/rating_star"
        android:background="@android:color/transparent"

        android:layout_margin="20dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieName">
    </ImageView>

    <TextView
        android:id="@+id/currentRating"
        android:layout_width="50dp"
        android:layout_height="wrap_content"

        android:text="4/5"
        android:textColor="@color/white"
        android:textSize="30sp"

        android:layout_margin="20dp"


        app:layout_constraintTop_toBottomOf="@id/movieName"
        app:layout_constraintStart_toEndOf="@id/currentRatingStar"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reviewButton"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="@color/navy"
        android:layout_margin="20dp"

        app:layout_constraintTop_toBottomOf="@id/movieName"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/reviewIcon"
            android:layout_width="26dp"
            android:layout_height="23dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/add_icon"
            android:background="@android:color/transparent"



            android:contentDescription="Write a review"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Write A Review"
            android:textColor="@color/white"

            app:layout_constraintStart_toEndOf="@id/reviewIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="250dp"

        android:layout_margin="20dp"
        android:text="@string/placeholder"
        android:textColor="@color/white"
        android:textSize="20sp"

        app:layout_constraintTop_toBottomOf="@id/reviewButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/highestReview"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/highestReview"
        android:layout_width="match_parent"
        android:layout_height="90dp"

        android:background="@color/black"
        android:alpha="0.5"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/highestReviewProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/white"

            android:layout_margin="20dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        </ImageView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reviewer"
                android:layout_marginTop="5dp"
                android:textColor="@color/white"
                android:textSize="20sp"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/placeholder"
                android:textColor="@color/white"

                android:textSize="9sp"
                android:layout_marginBottom="5dp"

                app:layout_constraintBottom_toBottomOf="parent"/>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/rating_star"
            android:background="@android:color/transparent"

            android:layout_marginTop="5dp"
            android:layout_margin="20dp">

        </ImageView>

        <TextView
            android:layout_width="40dp"
            android:layout_height="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"

            android:textColor="@color/white"
            android:text="5"
            android:textAlignment="center"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>