<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".profile"
    android:background="@drawable/background">

    <ImageButton
        android:id="@+id/returnButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="10dp"
        android:contentDescription="returnButton"
        android:src="@drawable/back_button"
        android:background="@android:color/transparent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/pageHeading"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="20dp"

        android:text="Your Profile"
        android:textColor="@color/white"
        android:textSize="30sp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/currentImage"
        android:layout_width="195dp"
        android:layout_height="195dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@color/white"
        android:layout_marginTop="100dp"
        />

    <Button
        android:id="@+id/changePictureButton"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="@color/dark_green"
        android:layout_margin="50dp"

        android:text="Change Profile Picture"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/currentImage"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <TextView
        android:id="@+id/currentUsername"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Username"
        android:textAlignment="center"
        android:textColor="@color/white"

        android:layout_margin="20dp"
        android:textSize="30sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changePictureButton"
        />

    <Button
        android:id="@+id/changeUsername"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="@color/dark_green"
        android:layout_margin="20dp"

        android:text="Change Username"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/currentUsername"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <Button
        android:id="@+id/changePassword"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="@color/dark_green"
        android:layout_margin="20dp"

        android:text="Change Password"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/changeUsername"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>